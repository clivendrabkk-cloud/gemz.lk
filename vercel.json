{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}]},
    {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}]},
    {"source": "/about.html", "headers": [{"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}]},
    {"source": "/admin.html", "headers": [{"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}]},
    {"source": "/cart.html", "headers": [{"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}]},
    {"source": "/collection.html", "headers": [{"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}]},
    {"source": "/contact.html", "headers": [{"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}]},
    {"source": "/gemstone.html", "headers": [{"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}]},
    {"source": "/insights.html", "headers": [{"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}]},
    {"source": "/jewellery-product.html", "headers": [{"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}]},
    {"source": "/login.html", "headers": [{"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}]},
    {"source": "/assets/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/css/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/js/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}
  ]
}
